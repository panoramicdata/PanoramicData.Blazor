@inherits ComponentBase

<div class="pdchat-message @(Message.Sender.IsUser ? "user" : "bot") @(UseFullWidthMessages ? "full-width" : "bubble") @GetMetaPositionClass() priority-@Message.Type.ToString().ToLower()">
	@if (UseFullWidthMessages)
	{
		@if (ShouldShowMetaOnRight())
		{
			<!-- Meta on RIGHT: Content first, then Meta -->
			<div class="pdchat-content">
				@if (!string.IsNullOrEmpty(Message.Title))
				{
					if (Message.IsTitleHtml)
					{
						<div class="pdchat-title-bar">@((MarkupString)Message.Title)</div>
					}
					else
					{
						<div class="pdchat-title-bar">@Message.Title</div>
					}
				}
				<div class="pdchat-text">
					@if (Message.Type == MessageType.Typing)
					{
						@RenderProgress
					}
					else if (Message.IsMessageHtml)
					{
						<span>@((MarkupString)@Message.Message)</span>
					}
					else
					{
						<span>@Message.Message</span>
					}
					@RenderForm
				</div>
			</div>
			@if (ShouldShowAnyMetadata())
			{
				<div class="pdchat-meta">
					@if (ShowMessageUserIcon)
					{
						<span class="pdchat-icon">@(UserIconSelector?.Invoke(Message) ?? "👤")</span>
					}
					<div class="pdchat-details">
						@if (ShowMessageUserName)
						{
							<span class="pdchat-username">@Message.Sender.Name</span>
						}
						@if (ShowMessageTimestamp)
						{
							<span class="pdchat-timestamp">@GetFormattedTimestamp()</span>
						}
					</div>
				</div>
			}
		}
		else
		{
			<!-- Meta on LEFT: Meta first, then Content -->
			@if (ShouldShowAnyMetadata())
			{
				<div class="pdchat-meta">
					@if (ShowMessageUserIcon)
					{
						<span class="pdchat-icon">@(UserIconSelector?.Invoke(Message) ?? "👤")</span>
					}
					<div class="pdchat-details">
						@if (ShowMessageUserName)
						{
							<span class="pdchat-username">@Message.Sender.Name</span>
						}
						@if (ShowMessageTimestamp)
						{
							<span class="pdchat-timestamp">@GetFormattedTimestamp()</span>
						}
					</div>
				</div>
			}
			<div class="pdchat-content">
				@if (!string.IsNullOrEmpty(Message.Title))
				{
					if (Message.IsTitleHtml)
					{
						<div class="pdchat-title-bar">@((MarkupString)Message.Title)</div>
					}
					else
					{
						<div class="pdchat-title-bar">@Message.Title</div>
					}
				}
				<div class="pdchat-text">
					@if (Message.Type == MessageType.Typing)
					{
						@RenderProgress
					}
					else if (Message.IsMessageHtml)
					{
						<span>@((MarkupString)@Message.Message)</span>
					}
					else
					{
						<span>@Message.Message</span>
					}
					@RenderForm
				</div>
			</div>
		}
	}
	else
	{
		@if (ShouldShowAnyMetadata())
		{
			<div class="pdchat-bubble-header">
				@if (ShowMessageUserIcon)
				{
					<span class="pdchat-icon">@(UserIconSelector?.Invoke(Message) ?? "👤")</span>
				}
				@if (ShowMessageUserName)
				{
					<span class="pdchat-username">@Message.Sender.Name</span>
				}
				@if (ShowMessageTimestamp)
				{
					<span class="pdchat-timestamp">@GetFormattedTimestamp()</span>
				}
			</div>
		}
		@if (!string.IsNullOrEmpty(Message.Title))
		{
			if (Message.IsTitleHtml)
			{
				<div class="pdchat-title-bar">@((MarkupString)Message.Title)</div>
			}
			else
			{
				<div class="pdchat-title-bar">@Message.Title</div>
			}
		}
		<div class="pdchat-text">
			@if (Message.Type == MessageType.Typing)
			{
				@RenderProgress
			}
			else if (Message.IsMessageHtml)
			{
				<span class="@(Message.Sender.IsUser ? "right" : "left")">@((MarkupString)@Message.Message)</span>
			}
			else
			{
				<span class="@(Message.Sender.IsUser ? "right" : "left")">@Message.Message</span>
			}
			@RenderForm
		</div>
	}
</div>

@* Issue #98: what an in-progress message shows while it is being composed. Previously this was a
   bare ellipsis, which is indistinguishable from a hung request - and for an agentic reply that
   takes a minute or more, that is most of the user's experience of the product. *@
@code {
	/// <summary>
	/// Renders an inline question form when the message carries one (issue #106).
	/// </summary>
	/// <remarks>
	/// Driven by the payload rather than by MessageType, so a consumer that sets Form but leaves the
	/// type alone still gets a form. Without a cascaded context - a PDMessage used outside a PDChat -
	/// the form still renders; it simply has nowhere to send the answers.
	/// </remarks>
	private RenderFragment RenderForm => __builder =>
	{
		if (Message.Form is not null)
		{
			<PDFormMessage Form="Message.Form"
						   OnSubmitted="@(async (ChatFormSubmission s) => { if (FormContext?.OnSubmitted is not null) { await FormContext.OnSubmitted(s); } })"
						   OnDismissed="@(async (Guid id) => { if (FormContext?.OnDismissed is not null) { await FormContext.OnDismissed(id); } })" />
		}
	};

	private RenderFragment RenderProgress => __builder =>
	{
		<div class="pdchat-progress">
			@if (Message.ProgressSteps is { Count: > 0 })
			{
				<ul class="pdchat-progress-steps">
					@foreach (var step in Message.ProgressSteps)
					{
						<li>@step</li>
					}
				</ul>
			}

			@if (Message.Thoughts is { Count: > 0 })
			{
				@foreach (var thought in Message.Thoughts)
				{
					<details class="pdchat-thought">
						<summary>@thought.Title</summary>
						<div class="pdchat-thought-text">@thought.Text</div>
					</details>
				}
			}

			@if (!string.IsNullOrWhiteSpace(Message.PartialMessage))
			{
				var partial = PartialMarkdown.Trim(Message.PartialMessage);

				@if (partial.Content.Length > 0)
				{
					<div class="pdchat-partial">@partial.Content</div>
				}
				@if (partial.Writing is not null)
				{
					<div class="pdchat-partial-writing">writing @partial.Writing&hellip;</div>
				}
			}

			<span class="typing-ellipsis">&nbsp;</span>
		</div>
	};
}
