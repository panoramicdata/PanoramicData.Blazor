<PDModal @ref="Modal"
		 Title="@_modalTitle"
		 ButtonClick="OnButtonClick"
		 BodyCssClass="p-0"
		 Buttons="_toolbarItems"
		 ButtonSize="ButtonSize"
		 CloseOnEscape="CloseOnEscape"
		 HideOnBackgroundClick="HideOnBackgroundClick"
		 Size="Size">

	<div class="pdfilemodalexplorer" style="height: @Height">
		<PDFileExplorer @ref="FileExplorer"
						ButtonSize="ButtonSize"
						DataProvider="DataProvider"
						AllowDrag="false"
						AllowDrop="false"
						AllowRename="@(ShowToolbar || ShowContextMenu)"
						AutoExpand="true"
						ExcludedPaths="ExcludedPaths"
						FilenamePattern="@_filenamePattern"
						FolderChanged="OnFolderChanged"
						GetItemIconCssClass="GetItemIconCssClassInternal"
						ItemDoubleClick="OnItemDoubleClick"
						ReadOnlyIconClass="@ReadOnlyIconClass"
						ReadOnlyIndicatorPosition="@ReadOnlyIndicatorPosition"
						ShowFiles="_showFiles"
						ShowNavigateUpButton="ShowNavigateUpButton"
						ShowToolbar="@ShowToolbar"
						ShowContextMenu="@ShowContextMenu"
						SelectionMode="TableSelectionMode.Single"
						SelectionChanged="OnSelectionChanged"
						TreeSort="TreeSort" />
	</div>
</PDModal>

<PDModal @ref="ModalConfirm"
		 Title="Confirm Overwrite"
		 ButtonSize="ButtonSize"
		 HideOnBackgroundClick="HideOnBackgroundClick"
		 Buttons="_confirmToolbarItems">
	<span>Are you sure you wish to overwrite '<b>@_filenameTextbox.Value</b>'?</span>
</PDModal>