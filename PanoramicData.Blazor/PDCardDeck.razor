@inherits PDComponentBase
@typeparam TCard

<div @ref="DeckElement" @attributes="GetDeckAttributes()" ondragover="event.preventDefault();">

	@if (!DataLoaded && Parent is null && ShowLoadingIcon)
	{
		<PDCardDeckLoadingIcon Message="@LoadingMessage" ShowElapsedTime="@ShowLoadingElapsedTime" />
	}

	else if (DeckTemplate is not null)
	{
		@DeckTemplate(this)
	}
	else
	{
		@foreach (var card in Cards)
		{
			<PDCard @ref="@Ref"
					@key="@($"{Id}_{card.Id}")"
					DraggingEnabled="@(IsEnabled && _canDrag)"
					Template="CardTemplate"
					Css="CardCss"
					Card="card"
					ParentCardDeck="this"
					IsAnimated="@IsAnimated" />
		}
	}

</div>