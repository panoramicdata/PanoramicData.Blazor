@namespace PanoramicData.Blazor
@inherits PDComponentBase

<div class="pd-studio @CssClass">
	<PDSplitter Direction="SplitDirection.Vertical">

		<!-- Top: toolbar and editor -->
		<PDSplitPanel Size="@((int)Options.MainSplitSizes[0])" CssClass="pd-studio-editor-panel">
			<div class="pd-studio-editor-wrapper">
				@if (Options.ShowMenu || Options.ShowToolbar)
				{
					<PDToolbar ButtonSize="ButtonSizes.Small" CssClass="pd-studio-toolbar">

						@if (Options.ShowMenu)
						{
							<PDToolbarButton Key="new"
											 Text="New"
											 IconCssClass="fas fa-file"
											 Click="OnNewClick" />
							@if (CurrentExamples.Count > 0)
							{
								<PDToolbarDropdown Text="Examples" IconCssClass="fas fa-book-open" Items="@ExampleMenuItems()" Click="OnExampleClick" />
							}
						}

						@if (Options.ShowMenu && Options.ShowToolbar)
						{
							<PDToolbarSeparator />
						}

						@if (Options.ShowToolbar)
						{
							<PDToolbarButton Key="play"
											 Text="@(_isExecuting ? "Cancel" : "Execute")"
											 IconCssClass="@(_isExecuting ? "fas fa-stop" : "fas fa-play")"
											 CssClass="@(_isExecuting ? "btn-danger" : "btn-success")"
											 Click="OnPlayCancelClick"
											 ShortcutKey="@_executeShortcut" />

							@if (EditorToolbarContent != null)
							{
								<PDToolbarSeparator />
								@EditorToolbarContent
							}
						}

					</PDToolbar>
				}

				<div class="pd-studio-editor-container">
					<PDMonacoEditor @ref="EditorRef"
									Language="@Options.Language"
									Theme="@Options.Theme"
									Value="@_currentCode"
									ValueChanged="OnCodeChanged"
									InitializeOptions="@GetMonacoInitializer"
									InitializeCache="@InitializeMethodCache"
									RegisterLanguages="@RegisterLanguages"
									InitializeLanguageAsync="@InitializeLanguageAsync"
									UpdateCacheAsync="@UpdateMethodCacheAsync" />

					@if (_isExecuting && !Options.IsEditingEnabledDuringExecution)
					{
						<div class="pd-studio-editor-overlay">
							<div class="spinner-border" role="status">
								<span class="visually-hidden">Executing...</span>
							</div>
						</div>
					}
				</div>
			</div>
		</PDSplitPanel>

		<!-- Bottom: Results and Messages tabs -->
		<PDSplitPanel Size="@((int)Options.MainSplitSizes[1])" CssClass="pd-studio-output-panel">
			<div class="pd-studio-tabs" role="tablist">
				<button type="button" role="tab" class="@TabCssClass(_resultsTab)" aria-selected="@IsTabActive(_resultsTab)" @onclick="() => SelectTab(_resultsTab)">
					Results
				</button>
				@if (Options.IsLoggingVisible)
				{
					<button type="button" role="tab" class="@TabCssClass(_messagesTab)" aria-selected="@IsTabActive(_messagesTab)" @onclick="() => SelectTab(_messagesTab)">
						Messages
						@if (_messages.Count > 0)
						{
							<span class="@MessagesBadgeCssClass">@MessagesBadgeText</span>
						}
					</button>
				}
			</div>

			<div class="pd-studio-tab-panel" role="tabpanel" hidden="@(!IsTabActive(_resultsTab))">
				<PDStudioResults @ref="ResultsRef"
								 Content="@_resultsContent"
								 IsExecuting="@_isExecuting"
								 ExecutionStatus="@_executionStatus"
								 ShowStatusBar="@Options.ShowStatusBar" />
			</div>

			@if (Options.IsLoggingVisible)
			{
				<div class="pd-studio-tab-panel pd-studio-messages" role="tabpanel" hidden="@(!IsTabActive(_messagesTab))">
					<div class="pd-studio-messages-toolbar">
						<select class="form-select form-select-sm pd-studio-messages-level" aria-label="Message level" value="@MessageLevelValue" @onchange="OnMessageLevelChanged">
							<option value="@LogLevel.Trace">All levels</option>
							<option value="@LogLevel.Information">Information and above</option>
							<option value="@LogLevel.Warning">Warnings and errors</option>
							<option value="@LogLevel.Error">Errors</option>
						</select>
						<input type="search" class="form-control form-control-sm pd-studio-messages-search" placeholder="Filter messages" aria-label="Filter messages" @bind="MessageSearch" @bind:event="oninput" />
						<button type="button" class="btn btn-sm btn-secondary pd-studio-messages-clear" @onclick="ClearMessages">Clear</button>
					</div>
					<div class="pd-studio-messages-list">
						@foreach (var message in FilteredMessages)
						{
							<div class="pd-studio-message @LevelCssClass(message.Level)">
								<span class="pd-studio-message-time">@message.Timestamp.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</span>
								<i class="@LevelIcon(message.Level)" aria-hidden="true"></i>
								<span class="pd-studio-message-level">@LevelName(message.Level)</span>
								<span class="pd-studio-message-text">@message.Text</span>
							</div>
						}
					</div>
				</div>
			}
		</PDSplitPanel>

	</PDSplitter>
</div>
