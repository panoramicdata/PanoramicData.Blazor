@namespace PanoramicData.Blazor
@inherits PDComponentBase

<div class="pd-studio @(LeftPanelContent != null ? "pd-studio-with-left-panel" : null) @CssClass">
	<div class="pd-studio-body">
	@if (LeftPanelContent != null)
	{
		<div class="pd-studio-left-panel">@LeftPanelContent</div>
	}
	<div class="pd-studio-main">
	<PDSplitter Direction="SplitDirection.Vertical">

		<!-- Top: toolbar and editor -->
		<PDSplitPanel Size="@((int)Options.MainSplitSizes[0])" CssClass="pd-studio-editor-panel">
			<div class="pd-studio-editor-wrapper">
				@if (Options.ShowMenu || Options.ShowToolbar)
				{
					<PDToolbar ButtonSize="@Options.ButtonSize" CssClass="pd-studio-toolbar">

						@ToolbarStartContent

						@if (Options.ShowToolbar)
						{
							<PDToolbarButton Key="play"
											 Text="@(_isExecuting ? Options.CancelButtonText : Options.ExecuteButtonText)"
											 IconCssClass="@(_isExecuting ? Options.CancelButtonIconCssClass : Options.ExecuteButtonIconCssClass)"
											 CssClass="@(_isExecuting ? Options.CancelButtonCssClass : Options.ExecuteButtonCssClass)"
											 Size="@Options.ButtonSize"
											 TextCssClass="@Options.ButtonTextCssClass"
											 ToolTip="@(_isExecuting ? Options.CancelButtonText : Options.ExecuteButtonToolTip ?? Options.ExecuteButtonText)"
											 Click="OnPlayCancelClick"
											 ShortcutKey="@_executeShortcut" />
						}

						@if (Options.ShowToolbar && HasMenuButtons)
						{
							<PDToolbarSeparator />
						}

						@if (Options.ShowMenu)
						{
							@if (Options.ShowNewButton)
							{
								<PDToolbarButton Key="new"
												 Text="@Options.NewButtonText"
												 IconCssClass="@Options.NewButtonIconCssClass"
												 CssClass="@Options.NewButtonCssClass"
												 Size="@Options.ButtonSize"
												 TextCssClass="@Options.ButtonTextCssClass"
												 Click="OnNewClick" />
							}
							@if (CurrentExamples.Count > 0)
							{
								<PDToolbarDropdown Text="@Options.ExamplesButtonText"
												   IconCssClass="@Options.ExamplesButtonIconCssClass"
												   CssClass="@Options.ExamplesButtonCssClass"
												   Size="@Options.ButtonSize"
												   TextCssClass="@Options.ButtonTextCssClass"
												   Items="@ExampleMenuItems()"
												   Click="OnExampleClick" />
							}
						}

						@* The host adds its own separator if it wants one *@
						@EditorToolbarContent

						@if (ToolbarEndContent != null)
						{
							<div class="pd-studio-toolbar-end">@ToolbarEndContent</div>
						}

					</PDToolbar>
				}

				<div class="pd-studio-editor-container">
					<PDMonacoEditor @ref="EditorRef"
									Language="@Options.Language"
									Theme="@Options.Theme"
									Value="@_currentCode"
									ValueChanged="OnCodeChanged"
									InitializeOptions="@GetMonacoInitializer"
									InitializeCache="@InitializeMethodCache"
									RegisterLanguages="@RegisterLanguages"
									InitializeLanguageAsync="@InitializeLanguageAsync"
									UpdateCacheAsync="@UpdateMethodCacheAsync" />

					@if (_isExecuting && !Options.IsEditingEnabledDuringExecution)
					{
						<div class="pd-studio-editor-overlay">
							<div class="spinner-border" role="status">
								<span class="visually-hidden">Executing...</span>
							</div>
						</div>
					}
				</div>
			</div>
		</PDSplitPanel>

		<!-- Bottom: Results and Messages tabs -->
		<PDSplitPanel Size="@((int)Options.MainSplitSizes[1])" CssClass="pd-studio-output-panel">
			<div class="pd-studio-tabs" role="tablist">
				<button type="button" role="tab" class="@TabCssClass(_resultsTab)" aria-selected="@IsTabActive(_resultsTab)" title="@Options.ResultsTabToolTip" @onclick="() => SelectTab(_resultsTab)">
					@Options.ResultsTabTitle
					@if (!string.IsNullOrWhiteSpace(Options.ResultsTabIconCssClass)) { <i class="pd-studio-tab-icon @(Options.ResultsTabIconCssClass)" aria-hidden="true"></i> }
				</button>
				@if (Options.IsLoggingVisible)
				{
					<button type="button" role="tab" class="@TabCssClass(_messagesTab)" aria-selected="@IsTabActive(_messagesTab)" title="@Options.MessagesTabToolTip" @onclick="() => SelectTab(_messagesTab)">
						@Options.MessagesTabTitle
						@if (!string.IsNullOrWhiteSpace(Options.MessagesTabIconCssClass)) { <i class="pd-studio-tab-icon @(Options.MessagesTabIconCssClass)" aria-hidden="true"></i> }
						@if (_messages.Count > 0)
						{
							<span class="@MessagesBadgeCssClass">@MessagesBadgeText</span>
						}
					</button>
				}
				@foreach (var tab in OutputTabs)
				{
					<button type="button" role="tab" class="@TabCssClass(tab.Key)" aria-selected="@IsTabActive(tab.Key)" title="@tab.ToolTip" @onclick="() => SelectTab(tab.Key)">
						@tab.Title
						@if (!string.IsNullOrWhiteSpace(tab.IconCssClass)) { <i class="pd-studio-tab-icon @(tab.IconCssClass)" aria-hidden="true"></i> }
					</button>
				}
			</div>

			<div class="pd-studio-tab-panel" role="tabpanel" hidden="@(!IsTabActive(_resultsTab))">
				<PDStudioResults @ref="ResultsRef"
								 Content="@_resultsContent"
								 ResultSet="@_resultSet"
								 IsExecuting="@_isExecuting"
								 ExecutionStatus="@_executionStatus"
								 ShowStatusBar="@Options.ShowStatusBar"
								 IsDark="@Options.Theme.Contains("dark", StringComparison.OrdinalIgnoreCase)"
								 StyleSheet="@Options.ResultsStyleSheet"
								 PlaceholderText="@Options.ResultsPlaceholderText" />
			</div>

			@if (Options.IsLoggingVisible)
			{
				<div class="pd-studio-tab-panel pd-studio-messages" role="tabpanel" hidden="@(!IsTabActive(_messagesTab))">
					<div class="pd-studio-messages-toolbar">
						<select class="form-select form-select-sm pd-studio-messages-level" aria-label="Message level" value="@MessageLevelValue" @onchange="OnMessageLevelChanged">
							<option value="@LogLevel.Trace">All levels</option>
							<option value="@LogLevel.Information">Information and above</option>
							<option value="@LogLevel.Warning">Warnings and errors</option>
							<option value="@LogLevel.Error">Errors</option>
						</select>
						<input type="search" class="form-control form-control-sm pd-studio-messages-search" placeholder="Filter messages" aria-label="Filter messages" @bind="MessageSearch" @bind:event="oninput" />
						<button type="button" class="btn btn-sm btn-secondary pd-studio-messages-clear" @onclick="ClearMessages">Clear</button>
					</div>
					<div class="pd-studio-messages-list">
						@{ var shown = FilteredMessages.ToList(); }
						@foreach (var message in shown)
						{
							<div class="pd-studio-message @LevelCssClass(message)">
								<span class="pd-studio-message-time">@message.Timestamp.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</span>
								<i class="@LevelIcon(message)" aria-hidden="true"></i>
								<span class="pd-studio-message-level">@LevelName(message)</span>
								<span class="pd-studio-message-text">@message.Text</span>
							</div>
						}
						@if (shown.Count == 0)
						{
							<div class="pd-studio-messages-empty">@(_messages.Count == 0 ? "No messages" : "No messages match the filter")</div>
						}
					</div>
				</div>
			}

			@foreach (var tab in OutputTabs)
			{
				<div class="pd-studio-tab-panel" role="tabpanel" hidden="@(!IsTabActive(tab.Key))">
					@tab.Content
				</div>
			}
		</PDSplitPanel>

	</PDSplitter>
	</div>
	</div>

	@if (FooterContent != null)
	{
		<div class="pd-studio-footer">@FooterContent</div>
	}
</div>
