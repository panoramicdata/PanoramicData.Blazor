<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>PanoramicData.Blazor</PackageId>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>Panoramic Data Limited</Authors>
    <Copyright>Copyright © Panoramic Data Limited 2020-2026</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>Panoramic Data.png</PackageIcon>
    <PackageTags>blazor components</PackageTags>
    <Title>PanoramicData.Blazor</Title>
    <Description>Blazor components</Description>
    <Summary>A library of components for Blazor projects</Summary>
    <Company>Panoramic Data Limited</Company>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/panoramicdata/PanoramicData.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/panoramicdata/PanoramicData.Blazor/</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Security: the .NET 10 servicing packages move to 10.0.15, fixing GHSA-x33c-w48q-qrgc (CVE-2026-114149, an ASP.NET Core denial of service) in Microsoft.AspNetCore.WebUtilities. PDFileExplorer: NavigateToFolderAsync opens a folder itself, loading its contents once without first showing the folder holding it; it returns false, with the deepest folder found open, when the folder is not there. A hidden preview panel no longer fetches a preview for every selection: PDFilePreview gains IsVisible, and the item chosen while it was hidden is fetched once it shows. PDContextMenu now opens at the pointer under CSS zoom or a scaled parent, and is no longer clipped by a panel that scrolls, using popper 2's fixed placement in place of popper 1's option, which popper 2 ignored. It sits above sticky headers at a z-index of 1000, which --pd-contextmenu-z-index overrides. Given an ExceptionHandler, PDContextMenu passes a failure in showing the menu or in an item's click to it instead of ending the Blazor circuit; without one, a failure is thrown as before, and PDFileExplorer passes its own handler to its menus.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="/" />
    <Content Remove="compilerconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BlazorMonaco" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Humanizer.Core" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PanoramicData.DeepCloner" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Linq.Dynamic.Core" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Panoramic Data.png" />
    <!--<_ContentIncludedByDefault Remove="wwwroot\css\main.css" />-->
    <None Include="compilerconfig.json" />
    <None Include="Panoramic Data.png" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Attributes\" />
  </ItemGroup>
</Project>
