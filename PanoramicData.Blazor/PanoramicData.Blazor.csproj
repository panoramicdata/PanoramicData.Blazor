<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>PanoramicData.Blazor</PackageId>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>Panoramic Data Limited</Authors>
    <Copyright>Copyright © Panoramic Data Limited 2020-2026</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>Panoramic Data.png</PackageIcon>
    <PackageTags>blazor components</PackageTags>
    <Title>PanoramicData.Blazor</Title>
    <Description>Blazor components</Description>
    <Summary>A library of components for Blazor projects</Summary>
    <Company>Panoramic Data Limited</Company>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/panoramicdata/PanoramicData.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/panoramicdata/PanoramicData.Blazor/</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
      - PDCardDeckGroup and PDCardDeck: new ShowLoadingIcon, LoadingMessage and ShowLoadingElapsedTime parameters turn the loading icon off (which also stops a group blocking the page while its decks load), change its message and hide its elapsed-time counter, through new Message and ShowElapsedTime parameters on PDCardDeckLoadingIcon. The icon's colour is the new --pd-carddeck-loading-color CSS variable, defaulting to --bs-emphasis-color, so it follows Bootstrap 5.3 dark mode instead of always being black. A deck now loads its cards and joins its group before it downloads its script, so a full page load no longer shows the loading icon while the script downloads, and its cards can be dragged once the script's drop listener is in place.
    </PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="/" />
    <Content Remove="compilerconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BlazorMonaco" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Humanizer.Core" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PanoramicData.DeepCloner" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Linq.Dynamic.Core" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Panoramic Data.png" />
    <!--<_ContentIncludedByDefault Remove="wwwroot\css\main.css" />-->
    <None Include="compilerconfig.json" />
    <None Include="Panoramic Data.png" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Attributes\" />
  </ItemGroup>
</Project>
