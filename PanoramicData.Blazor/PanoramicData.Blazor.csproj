<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>PanoramicData.Blazor</PackageId>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>Panoramic Data Limited</Authors>
    <Copyright>Copyright © Panoramic Data Limited 2020-2026</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>Panoramic Data.png</PackageIcon>
    <PackageTags>blazor components</PackageTags>
    <Title>PanoramicData.Blazor</Title>
    <Description>Blazor components</Description>
    <Summary>A library of components for Blazor projects</Summary>
    <Company>Panoramic Data Limited</Company>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/panoramicdata/PanoramicData.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/panoramicdata/PanoramicData.Blazor/</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
      - PDTable: fixed a double vertical scrollbar wherever a table sits directly under an ancestor with a definite height. BC-81 added overflow-x:auto to contain wide columns but left overflow-y unset, and the CSS overflow spec silently coerces an unset overflow-y to auto whenever overflow-x isn't visible - combined with the table's pre-existing height:100%, that let PDTable self-clip and grow its own inner scrollbar stacked on top of whatever was already scrolling the page around it. The base .pdtable rule now uses height:auto, so the table box always matches its own content height and can never have vertical overflow of its own to scroll; overflow-x containment is unaffected. The opt-in MaxHeight/StickyHeader/StickyPager scrollable-table mode keeps its own height:100% via .pdtable-container, so that behaviour is unchanged (BC-81).
    </PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="/" />
    <Content Remove="compilerconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BlazorMonaco" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Humanizer.Core" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PanoramicData.DeepCloner" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Linq.Dynamic.Core" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Panoramic Data.png" />
    <!--<_ContentIncludedByDefault Remove="wwwroot\css\main.css" />-->
    <None Include="compilerconfig.json" />
    <None Include="Panoramic Data.png" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Attributes\" />
  </ItemGroup>
</Project>
