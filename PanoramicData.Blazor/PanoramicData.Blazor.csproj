<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>PanoramicData.Blazor</PackageId>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>Panoramic Data Limited</Authors>
    <Copyright>Copyright © Panoramic Data Limited 2020-2026</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>Panoramic Data.png</PackageIcon>
    <PackageTags>blazor components</PackageTags>
    <Title>PanoramicData.Blazor</Title>
    <Description>Blazor components</Description>
    <Summary>A library of components for Blazor projects</Summary>
    <Company>Panoramic Data Limited</Company>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/panoramicdata/PanoramicData.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/panoramicdata/PanoramicData.Blazor/</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
      - Add PDStatusRollUp lazy-loading support via optional OnBeforeExpand callback: fires before each node is expanded, receives the target node, returns an updated node or null to leave unchanged. Backwards compatible - existing static trees are unaffected.
      - Add PDStatusRollUpNode.Expandable (bool?) tri-state: true forces drillable chevron (for nodes whose children arrive lazily), false forces non-drillable, null (default) auto-detects from Children.
      - Add PDStatusRollUp.TriggerIconSize parameter (string?) for custom icon sizing (e.g. "1rem", "16px"); defaults to .85rem baseline via CSS for backwards compatibility.
      - Add PDStatusRollUp.TriggerTitle parameter (string, default "Click to view status") for customisable hover tooltip on the trigger.
      - Add onmousedown/onmouseup stopPropagation to PDStatusRollUp trigger to prevent accidental row selection in parent PDTable components.
      - Add user-select: none to PDStatusRollUp popup header and item rows so text cannot be accidentally selected.
      - Replace hardcoded PDStatusRollUp icon colours with Bootstrap text utilities (text-danger, text-success, text-secondary); amber kept as --pdsr-color-amber CSS variable (default #fd7e14, overridable).
      - Fix PDStatusRollUp trigger icon not updating after lazy root expansion.
      - Fix PDStatusRollUp spinner positioning on deeper drill levels.
      - Fix PDStatusRollUp parent row icon not reflecting resolved status after drill-down.
      - Fix GenerateDocs.ps1 to handle inline [Parameter] attributes and generic type signatures.
    </PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="/" />
    <Content Remove="compilerconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BlazorMonaco" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Humanizer.Core" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PanoramicData.DeepCloner" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Linq.Dynamic.Core" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Panoramic Data.png" />
    <!--<_ContentIncludedByDefault Remove="wwwroot\css\main.css" />-->
    <None Include="compilerconfig.json" />
    <None Include="Panoramic Data.png" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Attributes\" />
  </ItemGroup>
</Project>