<div class="pd-monacoeditor">
	@if (_isMonacoReady)
	{
		<StandaloneCodeEditor @ref="_monacoEditor"
							  CssClass="resizable"
							  ConstructionOptions="_ => GetOptions()"
							  Id="@Id"
							  OnDidInit="OnMonacoEditorInitAsync"
							  OnDidChangeCursorSelection="OnMonacoEditorSelectionChangeAsync"
							  OnDidBlurEditorText="OnMonacoEditorBlurAsync"
							  OnDidChangeModelContent="OnMonacoEditorContentChangedAsync" />
	}
	else if (_monacoFailedToLoad)
	{
		<div class="pd-monacoeditor-unavailable">The code editor could not be loaded. Refresh the page to try again.</div>
	}
</div>
