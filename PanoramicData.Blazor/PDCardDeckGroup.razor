@inherits PDComponentBase
@typeparam TCard

<div @attributes=@GetAttributes()>
	@if (!AllDataLoaded() && ShowLoadingIcon)
    {
        <PDCardDeckLoadingIcon @ref="LoadingIcon" Message="@LoadingMessage" ShowElapsedTime="@ShowLoadingElapsedTime" />
    }

    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</div>
