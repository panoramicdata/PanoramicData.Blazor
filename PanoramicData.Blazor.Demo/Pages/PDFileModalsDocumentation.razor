<div class="pd-filemodals-documentation">
	<section id="overview">
		<h2 class="doc-section">Overview</h2>
		<p><code>PDFileModals</code> provides file operation dialogs (open, save, rename, delete confirmation).</p>
	</section>
	<section id="parameters">
		<h2 class="doc-section">Parameters</h2>
		<table class="table table-sm doc-props-table">
			<thead><tr><th>Parameter</th><th>Type</th><th>Description</th></tr></thead>
			<tbody>
				<tr><td><code>DataProvider</code></td><td><code>IFileExplorerDataProvider</code></td><td>File system provider</td></tr>
				<tr><td><code>ButtonSize</code></td><td><code>ButtonSizes</code></td><td>Size of every button in the dialog: the explorer's toolbar, the foot of the dialog and its overwrite confirmation. Defaults to Medium</td></tr>
				<tr><td><code>CancelButtonIconCssClass</code></td><td><code>string</code></td><td>Icon on the Cancel button, and on No when asked whether to overwrite. Defaults to <code>fas fa-fw fa-times</code></td></tr>
			</tbody>
		</table>
	</section>
</div>
