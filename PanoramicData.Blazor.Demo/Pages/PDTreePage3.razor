@page "/pdtree3"
@using PanoramicData.Blazor.Demo.Data

<h1>PDTree 3</h1>
<p class="text-muted">Example of a tree that can be reordered by drag and drop. The top quarter of a row drops before it, the bottom quarter after it, and the middle into it, shown by an insertion line or a highlight. People cannot have anything dropped into them, and dropping at the bottom of the last row in a group, left of its text, drops after the group.</p>

<DemoSourceView SourceFiles="Pages/PDTreePage3.razor, Pages/PDTreePage3.razor.cs, Pages/PDTreePage3.ReOrder.cs, Data/TreeDataProvider.cs">

	<PDDragContext>

		<!-- note that the IsLeaf parameter is set so as to help identify the leaf nodes,
		 this is not required when all data is loaded up front as it can be inferred -->
		<PDTree @ref="Tree"
				AllowDrag="true"
				AllowDrop="true"
				AllowDropInBetween="true"
				AllowDropAfterParent="true"
				IsDropPositionValid="IsDropPositionValid"
				DataProvider="_treeDataProvider"
				Drop="OnDrop"
				IconCssClass="(item, _) => GetIconCssClass(item)"
				KeyField="x => x.Id"
				ParentKeyField="x => x.ParentId"
				Ready="OnReady"
				ShowLines="true"
				ShowRoot="true"
				Sort="(a,b) => a.Order.CompareTo(b.Order)"
				TextField="x => x.Name"
				TItem="TreeItem">
		</PDTree>

	</PDDragContext>

	<EventView />

</DemoSourceView>