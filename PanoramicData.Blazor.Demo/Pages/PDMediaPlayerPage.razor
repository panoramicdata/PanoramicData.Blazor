@page "/pdmediaplayer"

<h1>PDMediaPlayer</h1>

<DemoSourceView SourceFiles="Pages/PDMediaPlayerPage.razor, Pages/PDMediaPlayerPage.razor.cs">
	<DocumentationContent>
		<PDMediaPlayerDocumentation />
	</DocumentationContent>
	<ChildContent>

		<p class="text-muted small mt-3">
			A one minute recording of a pretend radio show, synthesised for this demo (no network needed). The shaded
			part of the seek bar is the show proper, between hum-filled margins. Its markers point at the gaps
			(dead air), the squared-off loud bits (clipping) and the segments. Beneath the seek bar, the programme is
			divided into songs, talk (with timed transcripts), an advert and idents. Try K to play or pause, J and L
			(or [ and ]) to jump between markers, comma and full stop to jump between segments, P to play the current
			segment on its own, and &lt; and &gt; to change the speed, with focus inside the player. Double click a
			segment to play just that segment.
		</p>

		<div class="d-flex flex-wrap align-items-end gap-3 mb-3">
			<label class="form-label mb-0">
				Source
				<select class="form-select form-select-sm" @bind="SourceName">
					@foreach (var name in _sources.Keys)
					{
						<option value="@name">@name</option>
					}
				</select>
			</label>
			<label class="form-label mb-0">
				Segments
				<select class="form-select form-select-sm" id="mp-segments" @bind="SegmentSourceName">
					<option value="@HandMadeSegments">@HandMadeSegments</option>
					<option value="@DerivedSegments">@DerivedSegments</option>
					<option value="@NoSegments">@NoSegments</option>
				</select>
			</label>
			<label class="form-label mb-0">
				Marker list
				<select class="form-select form-select-sm" @bind="Placement">
					<option value="@MediaMarkerListPlacement.Below">Below</option>
					<option value="@MediaMarkerListPlacement.Side">Side</option>
				</select>
			</label>
			<label class="form-label mb-0">
				Seek lead (seconds)
				<input type="number" class="form-control form-control-sm" style="width: 5rem;" min="0" max="10" @bind="SeekLeadSeconds" />
			</label>
			<div class="form-check">
				<input class="form-check-input" type="checkbox" id="mp-range" @bind="ShadeRange" />
				<label class="form-check-label" for="mp-range">Shade the show (0:05 to 0:55)</label>
			</div>
			<div class="form-check">
				<input class="form-check-input" type="checkbox" id="mp-many" @bind="ManyMarkers" />
				<label class="form-check-label" for="mp-many">Add 5,000 generated markers</label>
			</div>
			<div class="form-check">
				<input class="form-check-input" type="checkbox" id="mp-persist" @bind="Persist" />
				<label class="form-check-label" for="mp-persist">Remember speed and position</label>
			</div>
			<div class="form-check">
				<input class="form-check-input" type="checkbox" id="mp-spectrogram" @bind="ShowSpectrogram" />
				<label class="form-check-label" for="mp-spectrogram">Spectrogram</label>
			</div>
			<div class="form-check">
				<input class="form-check-input" type="checkbox" id="mp-window" @bind="SlidingWindow" />
				<label class="form-check-label" for="mp-window">Sliding 12 second window</label>
			</div>
			<div class="form-check">
				<input class="form-check-input" type="checkbox" id="mp-controls" @bind="Controls" />
				<label class="form-check-label" for="mp-controls">Controls</label>
			</div>
			<div class="form-check">
				<input class="form-check-input" type="checkbox" id="mp-clock" @bind="BroadcastClock" />
				<label class="form-check-label" for="mp-clock">Broadcast clock time (14:30:00 start)</label>
			</div>
			<div class="form-check">
				<input class="form-check-input" type="checkbox" id="mp-freqlabels" @bind="FrequencyLabels" />
				<label class="form-check-label" for="mp-freqlabels">Frequency labels</label>
			</div>
			<div class="form-check">
				<input class="form-check-input" type="checkbox" id="mp-keypoints" @bind="ShowKeyPoints" />
				<label class="form-check-label" for="mp-keypoints">Key points (example data)</label>
			</div>
			<div class="form-check">
				<input class="form-check-input" type="checkbox" id="mp-landmarks" @bind="ShowLandmarks" />
				<label class="form-check-label" for="mp-landmarks">Landmarks (example data)</label>
			</div>
		</div>

		<label class="form-check mb-3"><input type="checkbox" class="form-check-input" @bind="showNotes" /> Show example piano roll (illustrative notes)</label>
		<label class="form-check mb-3"><input type="checkbox" class="form-check-input" @bind="showNoteSegments" disabled="@(!showNotes)" /> Show section labels and boundaries on the piano roll</label>
		<PDMediaPlayer @ref="Player"
					   ShowNotes="showNotes" Notes="exampleNotes" NotesHeight="260" ShowNoteSegments="showNoteSegments"
					   Src="@CurrentSource"
					   MediaKind="@CurrentKind"
					   Title="@($"Demo show: {SourceName}")"
					   Markers="_markers"
					   Segments="CurrentSegments"
					   KindLabels="_kindLabels"
					   KindColors="_kindColors"
					   SeekLead="TimeSpan.FromSeconds(SeekLeadSeconds)"
					   RangeStart="@(ShadeRange ? TimeSpan.FromSeconds(5) : null)"
					   RangeEnd="@(ShadeRange ? TimeSpan.FromSeconds(55) : null)"
					   MarkerListPlacement="Placement"
					   PersistKey="@(Persist ? "pdmediaplayer-demo" : null)"
					   ShowSpectrogram="ShowSpectrogram"
					   ShowControls="Controls"
					   SpectrogramWindow="@(SlidingWindow ? TimeSpan.FromSeconds(12) : null)"
					   ShowSpectrogramFrequencyLabels="FrequencyLabels"
					   SpectrogramStartTime="@(BroadcastClock ? new DateTimeOffset(2026, 10, 19, 14, 30, 0, TimeSpan.Zero) : null)"
					   ShowKeyPoints="ShowKeyPoints"
					   KeyPoints="_keyPoints"
					   ShowLandmarks="ShowLandmarks"
					   Landmarks="_landmarks"
					   ShowDownload="true"
					   DownloadFileName="demo-show.wav"
					   @bind-PlaybackRate="Rate"
					   @bind-Position="Position"
					   @bind-VisibleKinds="VisibleKinds"
					   OnReady="OnReady"
					   OnPlay="@(() => Log("OnPlay"))"
					   OnPause="@(() => Log("OnPause"))"
					   OnEnded="@(() => Log("OnEnded"))"
					   OnError="OnError"
					   OnMarkerSelected="OnMarkerSelected"
					   OnRangeEntered="@(p => Log("OnRangeEntered", p))"
					   OnRangeLeft="@(p => Log("OnRangeLeft", p))"
					   OnSegmentSelected="@(s => OnSegment("OnSegmentSelected", s))"
					   OnSegmentEntered="@(s => OnSegment("OnSegmentEntered", s))"
					   OnSegmentLeft="@(s => OnSegment("OnSegmentLeft", s))" />

		<div class="d-flex flex-wrap align-items-center gap-2 mt-3">
			<button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Player!.SeekAsync(TimeSpan.FromSeconds(30))">Seek to 0:30</button>
			<button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Player!.NextMarkerAsync(DeadAir)">Next dead air</button>
			<button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Player!.PreviousMarkerAsync(Clipping)">Previous clipping</button>
			<button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Player!.SetPlaybackRateAsync(1.5)">Speed 1.5×</button>
			<button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Player!.NextSegmentAsync(Song)">Next song</button>
			<button type="button" class="btn btn-sm btn-outline-primary" @onclick="PlayInterviewAsync">Play the interview only</button>
			<span class="small text-muted ms-2">
				Position @PositionText, speed @Rate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)×, @_lastMarkerText
			</span>
		</div>

	</ChildContent>
</DemoSourceView>
