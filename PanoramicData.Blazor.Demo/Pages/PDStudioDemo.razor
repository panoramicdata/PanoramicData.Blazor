@page "/pdstudio"

<h1>PDStudio - Multi-Language Development Environment</h1>

<DemoSourceView SourceFiles="Pages/PDStudioDemo.razor, Pages/PDStudioDemo.razor.cs, Pages/PDStudioDemo.Monaco.cs, Services/DemoStudioService.cs">

	<div class="container-fluid">
		<div class="row mb-3">
			<div class="col-12">
				<p>
					A versatile development environment supporting multiple languages including <strong>NCalc expressions</strong>, HTML, SQL, JavaScript, and more.
					Try writing multiline NCalc expressions using the built-in functions and variables, or switch languages to explore other capabilities.
				</p>
			</div>
		</div>

		<!-- PDStudio Component with fixed height -->
		<div class="row">
			<div class="col-12">
				@if (UseCustomColours)
				{
					<style>
						.pd-studio-demo-container {
							--pd-studio-separator-color: @SeparatorColour;
							--pd-studio-border-color: @BorderColour;
							--pd-studio-accent: @AccentColour;
						}
					</style>
				}
				<div class="pd-studio-demo-container">
					<PDStudio @ref="_studio"
							  StudioService="@StudioService"
							  Options="@StudioOptions"
							  Examples="@Examples"
							  OutputTabs="@(ShowAboutTab ? OutputTabs : [])"
							  OnCodeExecuted="OnCodeExecuted"
							  OnExecutionStateChanged="OnExecutionStateChanged"
							  OnLoggingVisibilityChanged="OnLoggingVisibilityChanged"
							  InitializeMonacoOptions="InitializeMonacoOptions"
							  InitializeMethodCache="InitializeMethodCache"
							  RegisterLanguages="RegisterLanguages"
							  InitializeLanguageAsync="InitializeLanguageAsync"
							  UpdateMethodCacheAsync="(_, _, _) => UpdateMethodCacheAsync()">

						<ToolbarStartContent>
							@if (ShowFileMenu)
							{
								<PDToolbarDropdown Text="File"
												   IconCssClass="fas fa-folder"
												   Size="@StudioOptions.ButtonSize"
												   TextCssClass="ps-2"
												   Items="@FileMenuItems"
												   Click="OnFileMenuClick" />
								<PDToolbarSeparator />
							}
						</ToolbarStartContent>

						<EditorToolbarContent>
							<PDToolbarSeparator />
							<PDToolbarButton Key="language"
											 Text="@($"Language: {StudioOptions.Language.ToUpper()}")"
											 IconCssClass="fas fa-code"
											 Size="@StudioOptions.ButtonSize"
											 TextCssClass="ps-2"
											 Click="OnChangeLanguage" />
						</EditorToolbarContent>

						<ToolbarEndContent>
							@if (ShowEndContent)
							{
								<span class="small text-secondary">Toolbar end slot</span>
							}
						</ToolbarEndContent>

						<LeftPanelContent>
							@if (ShowLeftPanel)
							{
								<div class="p-2">
									<div class="fw-semibold mb-1">Insert an example</div>
									@foreach (var example in Examples.Where(e => e.IsFor(StudioOptions.Language)))
									{
										<button type="button" class="btn btn-link btn-sm d-block p-0 text-start" @onclick="() => InsertExampleAsync(example)">@example.Name</button>
									}
								</div>
							}
						</LeftPanelContent>

						<FooterContent>
							@if (ShowFooter)
							{
								<span>Language: @StudioOptions.Language.ToUpperInvariant()</span>
								<span>Theme: @StudioOptions.Theme</span>
							}
						</FooterContent>

					</PDStudio>
				</div>
			</div>
		</div>

		<!-- Options: try each customisation -->
		<div class="row mt-3">
			<div class="col-12">
				<div class="card">
					<div class="card-header">
						<h6 class="mb-0">Options</h6>
					</div>
					<div class="card-body small">
						<div class="row g-3">
							<div class="col-md-3">
								<div class="fw-semibold mb-1">Toolbar</div>
								<div class="form-check"><input id="optToolbar" class="form-check-input" type="checkbox" @bind="StudioOptions.ShowToolbar" /><label class="form-check-label" for="optToolbar">Execute (ShowToolbar)</label></div>
								<div class="form-check"><input id="optMenu" class="form-check-input" type="checkbox" @bind="StudioOptions.ShowMenu" /><label class="form-check-label" for="optMenu">New and Examples (ShowMenu)</label></div>
								<div class="form-check"><input id="optNew" class="form-check-input" type="checkbox" @bind="StudioOptions.ShowNewButton" /><label class="form-check-label" for="optNew">New (ShowNewButton)</label></div>
								<label class="form-label mt-2 mb-1" for="optSize">Button size</label>
								<select id="optSize" class="form-select form-select-sm" @bind="StudioOptions.ButtonSize">
									<option value="@ButtonSizes.Small">Small</option>
									<option value="@ButtonSizes.Medium">Medium</option>
									<option value="@ButtonSizes.Large">Large</option>
								</select>
							</div>
							<div class="col-md-3">
								<div class="fw-semibold mb-1">Host slots</div>
								<div class="form-check"><input id="optFile" class="form-check-input" type="checkbox" @bind="ShowFileMenu" /><label class="form-check-label" for="optFile">File menu (ToolbarStartContent)</label></div>
								<div class="form-check"><input id="optEnd" class="form-check-input" type="checkbox" @bind="ShowEndContent" /><label class="form-check-label" for="optEnd">ToolbarEndContent</label></div>
								<div class="form-check"><input id="optLeft" class="form-check-input" type="checkbox" @bind="ShowLeftPanel" /><label class="form-check-label" for="optLeft">LeftPanelContent</label></div>
								<div class="form-check"><input id="optFooter" class="form-check-input" type="checkbox" @bind="ShowFooter" /><label class="form-check-label" for="optFooter">FooterContent</label></div>
								<div class="form-check"><input id="optAbout" class="form-check-input" type="checkbox" @bind="ShowAboutTab" /><label class="form-check-label" for="optAbout">About tab (OutputTabs)</label></div>
							</div>
							<div class="col-md-3">
								<div class="fw-semibold mb-1">Output</div>
								<div class="form-check"><input id="optMessages" class="form-check-input" type="checkbox" @bind="StudioOptions.IsLoggingVisible" /><label class="form-check-label" for="optMessages">Messages tab (IsLoggingVisible)</label></div>
								<div class="form-check"><input id="optStatus" class="form-check-input" type="checkbox" @bind="StudioOptions.ShowStatusBar" /><label class="form-check-label" for="optStatus">Status bar (ShowStatusBar)</label></div>
								<div class="form-check"><input id="optDark" class="form-check-input" type="checkbox" @bind="DarkEditor" /><label class="form-check-label" for="optDark">Dark editor (Theme: @StudioOptions.Theme)</label></div>
							</div>
							<div class="col-md-3">
								<div class="fw-semibold mb-1">Colours</div>
								<div class="form-check mb-1"><input id="optColours" class="form-check-input" type="checkbox" @bind="UseCustomColours" /><label class="form-check-label" for="optColours">Override --pd-studio-* colours</label></div>
								<label class="d-flex align-items-center gap-2 mb-1"><input type="color" @bind="SeparatorColour" disabled="@(!UseCustomColours)" />--pd-studio-separator-color</label>
								<label class="d-flex align-items-center gap-2 mb-1"><input type="color" @bind="BorderColour" disabled="@(!UseCustomColours)" />--pd-studio-border-color</label>
								<label class="d-flex align-items-center gap-2"><input type="color" @bind="AccentColour" disabled="@(!UseCustomColours)" />--pd-studio-accent</label>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Demo Information Panel -->
		<div class="row mt-4">
			<div class="col-md-6">
				<div class="card">
					<div class="card-header">
						<h6 class="mb-0">Supported Languages</h6>
					</div>
					<div class="card-body">
						<ul class="small mb-0">
							<li><strong>NCalc</strong>: Mathematical expressions with multiline support</li>
							<li><strong>HTML</strong>: Direct rendering and display</li>
							<li><strong>SQL</strong>: Mock database query execution</li>
							<li><strong>JavaScript</strong>: Simulated code execution</li>
							<li><strong>JSON</strong>: Parsing and formatting</li>
						</ul>
					</div>
				</div>
			</div>

			<div class="col-md-6">
				<div class="card">
					<div class="card-header">
						<h6 class="mb-0">NCalc Features (Default Language)</h6>
					</div>
					<div class="card-body small">
						<div class="mb-2">
							<strong>Variables:</strong> Pi, E, Now, Today, x (10), y (20)
						</div>
						<div class="mb-2">
							<strong>Math Functions:</strong> Sin, Cos, Sqrt, Abs, Pow, etc.
						</div>
						<div class="mb-2">
							<strong>Logic:</strong> if(), in(), isnull()
						</div>
						<div class="mb-0">
							<strong>Date/Time:</strong> AddDays(), AddHours(), Hour()
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Example Expressions -->
		<div class="row mt-3">
			<div class="col-md-6">
				<div class="card">
					<div class="card-header">
						<h6 class="mb-0">Example NCalc Expressions</h6>
					</div>
					<div class="card-body small">
						<div class="mb-2">
							<strong>Basic Math:</strong>
							<code>2 + 3 * 4 / (1 + 1)</code>
						</div>
						<div class="mb-2">
							<strong>Trigonometry:</strong>
							<code>Sin(Pi / 4) * Cos(Pi / 4)</code>
						</div>
						<div class="mb-2">
							<strong>Conditionals:</strong>
							<code>if(x > y, 'X is greater', 'Y is greater')</code>
						</div>
						<div class="mb-0">
							<strong>Date/Time:</strong>
							<code>AddDays(Today, 7)</code>
						</div>
					</div>
				</div>
			</div>

			<div class="col-md-6">
				<div class="card">
					<div class="card-header">
						<h6 class="mb-0">Studio Features</h6>
					</div>
					<div class="card-body">
						<ul class="small mb-0">
							<li><strong>Monaco Editor</strong>: Advanced code editor with IntelliSense</li>
							<li><strong>Syntax Highlighting</strong>: Custom themes for NCalc, SQL, and more</li>
							<li><strong>Auto-Completion</strong>: Context-aware suggestions and function signatures</li>
							<li><strong>New and Examples</strong>: clear the editor, or load an example for the current language</li>
							<li><strong>Execution Control</strong>: Run/Cancel with progress and timeout</li>
							<li><strong>Results Panel</strong>: Safe HTML output with real-time updates</li>
							<li><strong>Console Logging</strong>: Debug information with toggleable visibility</li>
							<li><strong>Keyboard Shortcuts</strong>: Ctrl+Enter to execute, menu shortcuts</li>
						</ul>
					</div>
				</div>
			</div>
		</div>

		<!-- Event Log -->
		@if (_events.Any())
		{
			<div class="row mt-3 mb-4">
				<div class="col-12">
					<div class="card">
						<div class="card-header">
							<h6 class="mb-0">Recent Events</h6>
						</div>
						<div class="card-body" style="max-height: 200px; overflow-y: auto;">
							@foreach (var evt in _events.TakeLast(10))
							{
								<div class="small mb-1">
									<span class="badge bg-primary">@evt.Timestamp.ToString("HH:mm:ss")</span>
									<strong>@evt.EventType</strong>: @evt.Description
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		}

	</div>

</DemoSourceView>