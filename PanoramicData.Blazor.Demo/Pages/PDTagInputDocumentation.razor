			<thead>
				<tr><th>Variable</th><th>Default</th><th>Description</th></tr>
			</thead>
			<tbody>
				<tr><td><code>--pd-taginput-bg</code></td><td>--bs-body-bg</td><td>Background of the control</td></tr>
				<tr><td><code>--pd-taginput-color</code></td><td>--bs-body-color</td><td>Text colour of the control</td></tr>
				<tr><td><code>--pd-taginput-border-color</code></td><td>--bs-border-color</td><td>Border colour of the control</td></tr>
				<tr><td><code>--pd-taginput-border-radius</code></td><td>0.375rem</td><td>Border radius of the control and dropdown</td></tr>
				<tr><td><code>--pd-taginput-focus-border-color</code></td><td>#86b7fe</td><td>Border colour when focused</td></tr>
				<tr><td><code>--pd-taginput-focus-shadow</code></td><td>Bootstrap focus ring</td><td>Box shadow when focused</td></tr>
				<tr><td><code>--pd-taginput-invalid-border-color</code></td><td>--bs-danger</td><td>Border colour after a rejected tag</td></tr>
				<tr><td><code>--pd-taginput-disabled-bg</code></td><td>--bs-secondary-bg</td><td>Background when disabled</td></tr>
				<tr><td><code>--pd-taginput-readonly-bg</code></td><td>--bs-tertiary-bg</td><td>Background when read-only</td></tr>
				<tr><td><code>--pd-taginput-gap</code></td><td>0.25rem</td><td>Gap between chips</td></tr>
				<tr><td><code>--pd-taginput-min-height</code></td><td>form-control height</td><td>Minimum height of the control</td></tr>
				<tr><td><code>--pd-taginput-padding</code></td><td>0.25rem 0.5rem</td><td>Padding of the control</td></tr>
				<tr><td><code>--pd-taginput-placeholder-color</code></td><td>--bs-secondary-color</td><td>Placeholder text colour</td></tr>
				<tr><td><code>--pd-taginput-tag-bg</code></td><td>--bs-primary-bg-subtle</td><td>Chip background</td></tr>
				<tr><td><code>--pd-taginput-tag-color</code></td><td>--bs-primary-text-emphasis</td><td>Chip text colour</td></tr>
				<tr><td><code>--pd-taginput-tag-border-color</code></td><td>--bs-primary-border-subtle</td><td>Chip border colour</td></tr>
				<tr><td><code>--pd-taginput-tag-border-radius</code></td><td>0.25rem</td><td>Chip border radius (1rem makes pills)</td></tr>
				<tr><td><code>--pd-taginput-tag-font-size</code></td><td>0.875em</td><td>Chip font size</td></tr>
				<tr><td><code>--pd-taginput-tag-padding</code></td><td>0.1rem 0.4rem</td><td>Chip padding</td></tr>
				<tr><td><code>--pd-taginput-remove-hover-bg</code></td><td>rgba(0,0,0,.15)</td><td>Remove button hover background</td></tr>
				<tr><td><code>--pd-taginput-dropdown-bg</code></td><td>--bs-body-bg</td><td>Dropdown background</td></tr>
				<tr><td><code>--pd-taginput-dropdown-color</code></td><td>--bs-body-color</td><td>Dropdown text colour</td></tr>
				<tr><td><code>--pd-taginput-dropdown-border-color</code></td><td>--bs-border-color</td><td>Dropdown border colour</td></tr>
				<tr><td><code>--pd-taginput-dropdown-hover-bg</code></td><td>--bs-tertiary-bg</td><td>Dropdown item hover background</td></tr>
				<tr><td><code>--pd-taginput-dropdown-active-bg</code></td><td>--bs-primary</td><td>Highlighted dropdown item background</td></tr>
