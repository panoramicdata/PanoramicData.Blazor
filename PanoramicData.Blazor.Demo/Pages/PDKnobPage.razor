@page "/pdknob"
@using PanoramicData.Blazor.Enums

<h1>PDKnob Demo</h1>

<DemoSourceView SourceFiles="Pages/PDKnobPage.razor,Pages/PDKnobPage.razor.cs">
<DocumentationContent>
<PDKnobDocumentation />
</DocumentationContent>
<ChildContent>
<div style="display: flex; gap: 48px; align-items: flex-start;">
		<div>
			<h3>Volume</h3>
			<PDKnob Mode="PDKnobMode.Volume" @bind-Value="VolumeValue" MaxDisplay="@MaxVolume" CapColor="@KnobColor" ActiveColor="@ActiveColor" Label="@KnobLabel" LabelPosition="@LabelPosition" LabelHeightPx="@_labelHeightPx" LabelCssClass="@LabelCssClass" />
			<div>Value: @(VolumeValue.ToString("F2"))</div>
		</div>
		<div>
			<h3>Balance</h3>
			<PDKnob Mode="PDKnobMode.Balance" @bind-Value="BalanceValue" CapColor="@KnobColor" ActiveColor="@ActiveColor" Label="@KnobLabel" LabelPosition="@LabelPosition" LabelHeightPx="@_labelHeightPx" LabelCssClass="@LabelCssClass" />
			<div>Value: @(BalanceValue.ToString("F2"))</div>
		</div>
		<div>
			<h3>Gain</h3>
			<PDKnob Mode="PDKnobMode.Gain" @bind-Value="GainValue" CapColor="@KnobColor" ActiveColor="@ActiveColor" Label="@KnobLabel" LabelPosition="@LabelPosition" LabelHeightPx="@_labelHeightPx" LabelCssClass="@LabelCssClass" />
			<div>Value: @(GainValue.ToString("F2"))</div>
		</div>
		<div>
			<h3>Snapping</h3>
			<PDKnob Mode="PDKnobMode.Volume" @bind-Value="@SnapValue" SnapIncrement="@_snapIncrement" CapColor="@KnobColor" ActiveColor="@ActiveColor" Label="@KnobLabel" LabelPosition="@LabelPosition" LabelHeightPx="@_labelHeightPx" LabelCssClass="@LabelCssClass" />
			<div>Value: @(SnapValue.ToString("F2"))</div>
		</div>
	</div>

	<div class="m-t-20">
		<label>Max Volume</label>
		<input type="number" @bind="MaxVolume" />
	</div>
	<div class="m-t-10">
		<label>Snap Increment</label>
		<input type="number" step="0.01" @bind_="snapIncrement" />
	</div>
	<div class="m-t-10">
		<label>Knob Color</label>
		<PDColorPicker @bind-Value="KnobColor" CssClass="btn-outline-secondary" />
	</div>
	<div class="m-t-10">
		<label>Active Color</label>
		<PDColorPicker @bind-Value="ActiveColor" CssClass="btn-outline-secondary" />
	</div>
	<div class="m-t-10">
		<label>Label</label>
		<input type="text" @bind="KnobLabel" />
	</div>
	<div class="m-t-10">
		<label>Label Position</label>
		<select @bind="LabelPosition">
			<option value="@(PDLabelPosition.Above)">Above</option>
			<option value="@(PDLabelPosition.Below)">Below</option>
		</select>
	</div>
	<div class="m-t-10">
		<label>Label Height (px)</label>
		<input type="number" @b_ind="labelHeightPx" />
	</div>
	<div class="m-t-10">
		<label>Label CSS Class</label>
		<input type="text" @bind="LabelCssClass" />
	</div>
	</ChildContent>
</DemoSourceView>
