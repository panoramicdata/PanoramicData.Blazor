@page "/pdtimeline"

<h1>PDTimeline</h1>

<style>
	.pd-timeline-toolbar {
		border-top: 1px solid silver;
		border-left: 1px solid silver;
		border-right: 1px solid silver;
	}
</style>


<DemoSourceView SourceFiles="Pages/PDTimelinePage.razor, Pages/PDTimelinePage.razor.cs">
<DocumentationContent>
<PDTimelineDocumentation />
</DocumentationContent>
<ChildContent>
	<section class="border rounded p-3 mb-4">
		<div class="d-flex align-items-center justify-content-between mb-2">
			<div>
				<h4 class="mb-1">Live Follow Now</h4>
				<div class="text-muted">Seconds are deliberately wide so the right edge and rolling 15-second selection visibly advance.</div>
			</div>
			<span class="badge @(LiveFollowNow ? "bg-success" : "bg-secondary")">
				@(LiveFollowNow ? "Following Now" : "History paused")
			</span>
		</div>

		<PDTimelineToolbar Timeline="LiveTimeline"
			ShowFollowNow="true"
			ShowRange="true"
			ShowScale="true"
			ShowSelection="true" />

		<div style="height: 180px;">
			<PDTimeline @ref="LiveTimeline"
				@bind-FollowNow="LiveFollowNow"
				DataProvider="GetLiveTimelineData"
				FollowNowRefreshInterval="TimeSpan.FromMilliseconds(250)"
				Initialized="OnLiveTimelineInitializedAsync"
				MinDateTime="_liveMinDate"
				Options="_liveTimelineOptions"
				Scale="TimelineScale.Seconds"
				SelectionChanged="OnLiveSelectionChanged" />
		</div>

		<small class="text-muted d-block">
			Rolling selection: @(_liveSelection is null ? "none" : $"{_liveSelection.StartTime:HH:mm:ss} - {_liveSelection.EndTime:HH:mm:ss}")
		</small>
		<small class="text-muted">Pan, select, or zoom to pause. Use the clock button to re-anchor the viewport and selection to Now.</small>
	</section>

<div>
		<div class="toolbar">

			<div class="form-check me-2">
				<input type="checkbox" class="form-check-input" id="enabledCheck" checked="IsEnabled"
					   @oninput="(a) => IsEnabled = Convert.ToBoolean(a.Value)">
				<label class="form-check-label" for="enabledCheck">Enabled</label>
			</div>

			<EditForm class="d-flex" Model="_model">

				<div class="me-2">
					<span>Disable Before</span>
					<InputDate class="form-control form-control-sm"
							   @bind-Value="_model.DisableBefore" />
				</div>

				<div class="me-2">
					<span>Disable After</span>
					<InputDate class="form-control form-control-sm"
							   @bind-Value="_model.DisableAfter" />
				</div>

			</EditForm>

			<PDButton Click="OnSetData"
					  CssClass="btn-secondary ms-2"
					  Size="ButtonSizes.Small"
					  Text="Set Data" />

			<PDButton Click="OnClearData"
					  CssClass="btn-secondary ms-2"
					  Size="ButtonSizes.Small"
					  Text="Clear Data" />

			<PDButton Click="OnZoomToEnd"
					  CssClass="btn-secondary ms-2"
					  Size="ButtonSizes.Small"
					  Text="Zoom End" />

			<div class="form-check ms-2">
				<input type="checkbox" class="form-check-input" id="moreDataCheck" checked="@MoreDataAvailable"
					   @oninput="(a) => MoreDataAvailable = Convert.ToBoolean(a.Value)">
				<label class="form-check-label" for="moreDataCheck">More Data</label>
			</div>

		</div>

		<PDTimelineToolbar ShowRange="false"
						   Timeline="Timeline" />

		<PDSplitter Direction="SplitDirection.Horizontal" ExpandToMin="true">
			<PDSplitPanel Size="1" MinSize="200">
				<div style="padding: 10px;">
					<h5>Sample Content (drag splitter to move timeline)</h5>
					<p>This panel demonstrates the fix for PDTimeline when moved via PDSplitter.</p>
					<p>Drag the splitter to move the timeline horizontally and verify that selection still works correctly.</p>
				</div>
			</PDSplitPanel>
			<PDSplitPanel Size="1" MinSize="200">
				<PDTimeline @ref="Timeline"
							DataProvider="GetTimelineData"
							DisableAfter="_model.DisableAfter"
							DisableBefore="_model.DisableBefore"
							IsEnabled="IsEnabled"
							NewMaxDateTimeAvailable="MoreDataAvailable"
							NewMinDateTimeAvailable="MoreDataAvailable"
							MaxDateTime="_maxDate"
							MinDateTime="_minDate"
							Options="_timelineOptions"
							Refreshed="OnRefreshed"
							SelectionChanged="OnSelectionChanged"
							SelectionChangeEnd="OnSelectionChangeEnd"
							Scale="_model.Scale"
							ScaleChanged="OnScaleChanged"
							UpdateMaxDate="OnUpdateMaxDate"
							UpdateMinDate="OnUpdateMinDate" />
			</PDSplitPanel>
		</PDSplitter>

		<div>
			Range: @($"{_minDate:g} - {_maxDate:g}"))
		</div>
		<div>
			Selection: @(_selection is null ? "none" : _selection.ToString())
		</div>

	</div>

	<EventView />

	</ChildContent>
</DemoSourceView>
