@page "/pdaudiochannel"

<h1>PDAudioChannel</h1>

<DemoSourceView SourceFiles="Pages/PDAudioChannelPage.razor, Pages/PDAudioChannelPage.razor.cs">
<DocumentationContent>
<PDAudioChannelDocumentation />
</DocumentationContent>
<ChildContent>

<div class="mb-3">
		<h3>Basic Audio Channel</h3>
		<span class="text-muted small">A single audio channel with default settings</span>
	</div>

	<div style="display: inline-block;">
		<PDAudioChannel Label="Channel 1"
						FaderValue="0.7"
						GainValue="0.6" />
	</div>

	<hr class="my-4" />

	<div class="mb-3">
		<h3>Custom Colors</h3>
		<span class="text-muted small">Channels with custom knob and button colors - interact to see events</span>
	</div>

	<CascadingValue Value="_colorEventManager">
		<div class="row g-3">
			<div class="col-12 col-lg-8">
				<div style="display: flex; gap: 20px; flex-wrap: wrap;">
					<PDAudioChannel Label="Guitar"
									FaderValue="@GuitarFader"
									GainValue="@GuitarGain"
									PflValue="@GuitarPfl"
									MuteValue="@GuitarMute"
									FaderValueChanged="@(v => GuitarFader = OnColorDemoValueChanged("Guitar", "Fader", v))"
									GainValueChanged="@(v => GuitarGain = OnColorDemoValueChanged("Guitar", "Gain", v))"
									CompValueChanged="@(v => GuitarComp = OnColorDemoValueChanged("Guitar", "Comp", v))"
									PflValueChanged="@(v => GuitarPfl = OnColorDemoValueChanged("Guitar", "PFL", v))"
									MuteValueChanged="@(v => GuitarMute = OnColorDemoValueChanged("Guitar", "Mute", v))"
									GainColor="orange"
									CompColor="cyan"
									EqColor="yellow"
									DspColor="lime"
									PanColor="magenta"
									PflActiveColor="#ff0"
									PflInactiveColor="#880" />

					<PDAudioChannel Label="Bass"
									FaderValue="@BassFader"
									PflValue="@BassPfl"
									MuteValue="@BassMute"
									FaderValueChanged="@(v => BassFader = OnColorDemoValueChanged("Bass", "Fader", v))"
									GainValueChanged="@(v => BassGain = OnColorDemoValueChanged("Bass", "Gain", v))"
									PflValueChanged="@(v => BassPfl = OnColorDemoValueChanged("Bass", "PFL", v))"
									MuteValueChanged="@(v => BassMute = OnColorDemoValueChanged("Bass", "Mute", v))"
									GainColor="#f0f"
									CompColor="#0ff"
									EqColor="pink"
									MuteActiveColor="#0ff"
									MuteInactiveColor="#088" />

					<PDAudioChannel Label="Drums"
									FaderValue="@DrumsFader"
									PflValue="@DrumsPfl"
									MuteValue="@DrumsMute"
									FaderValueChanged="@(v => DrumsFader = OnColorDemoValueChanged("Drums", "Fader", v))"
									GainValueChanged="@(v => DrumsGain = OnColorDemoValueChanged("Drums", "Gain", v))"
									PflValueChanged="@(v => DrumsPfl = OnColorDemoValueChanged("Drums", "PFL", v))"
									MuteValueChanged="@(v => DrumsMute = OnColorDemoValueChanged("Drums", "Mute", v))"
									GainColor="white"
									CompColor="silver"
									DspColor="gold" />
				</div>
			</div>
			<div class="col-12 col-lg-4">
				<EventView />
			</div>
		</div>
	</CascadingValue>

	<hr class="my-4" />

	<div class="mb-3">
		<h3>Interactive Controls with Event Logging</h3>
		<span class="text-muted small">Channel with bound values that can be controlled - events shown on the right</span>
	</div>

	<CascadingValue Value="_interactiveEventManager">
		<div class="row g-3">
			<div class="col-12 col-lg-8">
				<PDAudioChannel FaderValue="@FaderValue"
								GainValue="@GainValue"
								CompValue="@CompValue"
								EqHighValue="@EqHighValue"
								EqMidValue="@EqMidValue"
								EqLowValue="@EqLowValue"
								DspValue="@DspValue"
								PanValue="@PanValue"
								PflValue="@PflValue"
								MuteValue="@MuteValue"
								FaderValueChanged="@(v => FaderValue = OnValueChanged("Fader", v))"
								GainValueChanged="@(v => GainValue = OnValueChanged("Gain", v))"
								CompValueChanged="@(v => CompValue = OnValueChanged("Comp", v))"
								EqHighValueChanged="@(v => EqHighValue = OnValueChanged("EQ High", v))"
								EqMidValueChanged="@(v => EqMidValue = OnValueChanged("EQ Mid", v))"
								EqLowValueChanged="@(v => EqLowValue = OnValueChanged("EQ Low", v))"
								DspValueChanged="@(v => DspValue = OnValueChanged("DSP", v))"
								PanValueChanged="@(v => PanValue = OnValueChanged("Pan", v))"
								PflValueChanged="@(v => PflValue = OnValueChanged("PFL", v))"
								MuteValueChanged="@(v => MuteValue = OnValueChanged("Mute", v))"
								Label="Vocals" />
			</div>
			<div class="col-12 col-lg-4">
				<EventView />
			</div>
		</div>
	</CascadingValue>

	<hr class="my-4" />

	<div class="mb-3">
		<h3>Disabled Channel</h3>
		<span class="text-muted small">A channel in disabled state with diagonal hash overlay</span>
	</div>

	<div style="display: inline-block;">
		<PDAudioChannel Label="Disabled"
						FaderValue="0.5"
						IsEnabled="false" />
	</div>

	<hr class="my-4" />

	<div class="mb-3">
		<h3>Multiple Channels</h3>
		<span class="text-muted small">Example showing multiple channels together - interact to see events</span>
	</div>

	<CascadingValue Value="_multiEventManager">
		<div class="row g-3">
			<div class="col-12 col-lg-8">
				<div style="display: flex; gap: 20px; flex-wrap: wrap;">
					<PDAudioChannel Label="Ch 1" 
									FaderValue="@Multi1Fader"
									GainValue="@Multi1Gain"
									CompValue="@Multi1Comp"
									EqHighValue="@Multi1EqHigh"
									EqMidValue="@Multi1EqMid"
									EqLowValue="@Multi1EqLow"
									DspValue="@Multi1Dsp"
									PanValue="@Multi1Pan"
									PflValue="@Multi1Pfl"
									MuteValue="@Multi1Mute"
									FaderValueChanged="@(v => Multi1Fader = OnMultiChannelValueChanged("Ch 1", "Fader", v))"
									GainValueChanged="@(v => Multi1Gain = OnMultiChannelValueChanged("Ch 1", "Gain", v))"
									CompValueChanged="@(v => Multi1Comp = OnMultiChannelValueChanged("Ch 1", "Comp", v))"
									EqHighValueChanged="@(v => Multi1EqHigh = OnMultiChannelValueChanged("Ch 1", "EQ High", v))"
									EqMidValueChanged="@(v => Multi1EqMid = OnMultiChannelValueChanged("Ch 1", "EQ Mid", v))"
									EqLowValueChanged="@(v => Multi1EqLow = OnMultiChannelValueChanged("Ch 1", "EQ Low", v))"
									DspValueChanged="@(v => Multi1Dsp = OnMultiChannelValueChanged("Ch 1", "DSP", v))"
									PanValueChanged="@(v => Multi1Pan = OnMultiChannelValueChanged("Ch 1", "Pan", v))"
									PflValueChanged="@(v => Multi1Pfl = OnMultiChannelValueChanged("Ch 1", "PFL", v))"
									MuteValueChanged="@(v => Multi1Mute = OnMultiChannelValueChanged("Ch 1", "Mute", v))" />
					<PDAudioChannel Label="Ch 2" 
									FaderValue="@Multi2Fader" 
									GainValue="@Multi2Gain"
									CompValue="@Multi2Comp"
									EqHighValue="@Multi2EqHigh"
									EqMidValue="@Multi2EqMid"
									EqLowValue="@Multi2EqLow"
									DspValue="@Multi2Dsp"
									PanValue="@Multi2Pan"
									PflValue="@Multi2Pfl"
									MuteValue="@Multi2Mute"
									FaderValueChanged="@(v => Multi2Fader = OnMultiChannelValueChanged("Ch 2", "Fader", v))"
									GainValueChanged="@(v => Multi2Gain = OnMultiChannelValueChanged("Ch 2", "Gain", v))"
									CompValueChanged="@(v => Multi2Comp = OnMultiChannelValueChanged("Ch 2", "Comp", v))"
									EqHighValueChanged="@(v => Multi2EqHigh = OnMultiChannelValueChanged("Ch 2", "EQ High", v))"
									EqMidValueChanged="@(v => Multi2EqMid = OnMultiChannelValueChanged("Ch 2", "EQ Mid", v))"
									EqLowValueChanged="@(v => Multi2EqLow = OnMultiChannelValueChanged("Ch 2", "EQ Low", v))"
									DspValueChanged="@(v => Multi2Dsp = OnMultiChannelValueChanged("Ch 2", "DSP", v))"
									PanValueChanged="@(v => Multi2Pan = OnMultiChannelValueChanged("Ch 2", "Pan", v))"
									PflValueChanged="@(v => Multi2Pfl = OnMultiChannelValueChanged("Ch 2", "PFL", v))"
									MuteValueChanged="@(v => Multi2Mute = OnMultiChannelValueChanged("Ch 2", "Mute", v))" />
					<PDAudioChannel Label="Ch 3" 
									FaderValue="@Multi3Fader" 
									GainValue="@Multi3Gain"
									CompValue="@Multi3Comp"
									EqHighValue="@Multi3EqHigh"
									EqMidValue="@Multi3EqMid"
									EqLowValue="@Multi3EqLow"
									DspValue="@Multi3Dsp"
									PanValue="@Multi3Pan"
									PflValue="@Multi3Pfl"
									MuteValue="@Multi3Mute"
									FaderValueChanged="@(v => Multi3Fader = OnMultiChannelValueChanged("Ch 3", "Fader", v))"
									GainValueChanged="@(v => Multi3Gain = OnMultiChannelValueChanged("Ch 3", "Gain", v))"
									CompValueChanged="@(v => Multi3Comp = OnMultiChannelValueChanged("Ch 3", "Comp", v))"
									EqHighValueChanged="@(v => Multi3EqHigh = OnMultiChannelValueChanged("Ch 3", "EQ High", v))"
									EqMidValueChanged="@(v => Multi3EqMid = OnMultiChannelValueChanged("Ch 3", "EQ Mid", v))"
									EqLowValueChanged="@(v => Multi3EqLow = OnMultiChannelValueChanged("Ch 3", "EQ Low", v))"
									DspValueChanged="@(v => Multi3Dsp = OnMultiChannelValueChanged("Ch 3", "DSP", v))"
									PanValueChanged="@(v => Multi3Pan = OnMultiChannelValueChanged("Ch 3", "Pan", v))"
									PflValueChanged="@(v => Multi3Pfl = OnMultiChannelValueChanged("Ch 3", "PFL", v))"
									MuteValueChanged="@(v => Multi3Mute = OnMultiChannelValueChanged("Ch 3", "Mute", v))" />
					<PDAudioChannel Label="Ch 4" 
									FaderValue="@Multi4Fader" 
									GainValue="@Multi4Gain"
									CompValue="@Multi4Comp"
									EqHighValue="@Multi4EqHigh"
									EqMidValue="@Multi4EqMid"
									EqLowValue="@Multi4EqLow"
									DspValue="@Multi4Dsp"
									PanValue="@Multi4Pan"
									PflValue="@Multi4Pfl"
									MuteValue="@Multi4Mute"
									FaderValueChanged="@(v => Multi4Fader = OnMultiChannelValueChanged("Ch 4", "Fader", v))"
									GainValueChanged="@(v => Multi4Gain = OnMultiChannelValueChanged("Ch 4", "Gain", v))"
									CompValueChanged="@(v => Multi4Comp = OnMultiChannelValueChanged("Ch 4", "Comp", v))"
									EqHighValueChanged="@(v => Multi4EqHigh = OnMultiChannelValueChanged("Ch 4", "EQ High", v))"
									EqMidValueChanged="@(v => Multi4EqMid = OnMultiChannelValueChanged("Ch 4", "EQ Mid", v))"
									EqLowValueChanged="@(v => Multi4EqLow = OnMultiChannelValueChanged("Ch 4", "EQ Low", v))"
									DspValueChanged="@(v => Multi4Dsp = OnMultiChannelValueChanged("Ch 4", "DSP", v))"
									PanValueChanged="@(v => Multi4Pan = OnMultiChannelValueChanged("Ch 4", "Pan", v))"
									PflValueChanged="@(v => Multi4Pfl = OnMultiChannelValueChanged("Ch 4", "PFL", v))"
									MuteValueChanged="@(v => Multi4Mute = OnMultiChannelValueChanged("Ch 4", "Mute", v))" />
					<PDAudioChannel Label="Ch 5" 
									FaderValue="@Multi5Fader" 
									GainValue="@Multi5Gain"
									CompValue="@Multi5Comp"
									EqHighValue="@Multi5EqHigh"
									EqMidValue="@Multi5EqMid"
									EqLowValue="@Multi5EqLow"
									DspValue="@Multi5Dsp"
									PanValue="@Multi5Pan"
									PflValue="@Multi5Pfl"
									MuteValue="@Multi5Mute"
									FaderValueChanged="@(v => Multi5Fader = OnMultiChannelValueChanged("Ch 5", "Fader", v))"
									GainValueChanged="@(v => Multi5Gain = OnMultiChannelValueChanged("Ch 5", "Gain", v))"
									CompValueChanged="@(v => Multi5Comp = OnMultiChannelValueChanged("Ch 5", "Comp", v))"
									EqHighValueChanged="@(v => Multi5EqHigh = OnMultiChannelValueChanged("Ch 5", "EQ High", v))"
									EqMidValueChanged="@(v => Multi5EqMid = OnMultiChannelValueChanged("Ch 5", "EQ Mid", v))"
									EqLowValueChanged="@(v => Multi5EqLow = OnMultiChannelValueChanged("Ch 5", "EQ Low", v))"
									DspValueChanged="@(v => Multi5Dsp = OnMultiChannelValueChanged("Ch 5", "DSP", v))"
									PanValueChanged="@(v => Multi5Pan = OnMultiChannelValueChanged("Ch 5", "Pan", v))"
									PflValueChanged="@(v => Multi5Pfl = OnMultiChannelValueChanged("Ch 5", "PFL", v))"
									MuteValueChanged="@(v => Multi5Mute = OnMultiChannelValueChanged("Ch 5", "Mute", v))" />
				</div>
			</div>
			<div class="col-12 col-lg-4">
				<EventView />
			</div>
		</div>
	</CascadingValue>

	</ChildContent>
</DemoSourceView>
