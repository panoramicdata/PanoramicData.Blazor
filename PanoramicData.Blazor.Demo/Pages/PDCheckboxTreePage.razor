@page "/pdcheckboxtree"
@using PanoramicData.Blazor.Demo.Data

<h1>PDCheckboxTree</h1>

<style>
	.demo-tree-box {
		border: 1px solid #dee2e6;
		border-radius: 0.375rem;
		padding: 0.5rem;
		height: 22rem;
		overflow-y: auto;
	}

	.demo-checked-box {
		border: 1px solid #dee2e6;
		border-radius: 0.375rem;
		padding: 0.75rem;
		min-height: 8rem;
	}
</style>

<DemoSourceView SourceFiles="Pages/PDCheckboxTreePage.razor, Pages/PDCheckboxTreePage.razor.cs">

	<p class="text-muted">
		A hierarchical multi-select picker: a <code>PDTree</code> whose nodes each carry a checkbox.
		Checked state is exposed as the node keys via <code>@@bind-CheckedKeys</code>.
	</p>

	<h4>Files and folders</h4>
	<div class="d-flex align-items-center gap-3 mb-2">
		<PDToggleSwitch @bind-Value="_showLines" Label="Show lines" />
		<PDToggleSwitch @bind-Value="_showRoot" Label="Show root" />
	</div>

	<div class="row">
		<div class="col-md-7">
			<div class="demo-tree-box">
				<PDCheckboxTree TItem="FileExplorerItem"
								DataProvider="_dataProvider"
								KeyField="x => x.Path"
								ParentKeyField="x => x.ParentPath"
								TextField="x => x.Name"
								IsLeaf="x => x.EntryType == FileExplorerItemType.File"
								IconCssClass="GetIconCssClass"
								LoadOnDemand="true"
								ShowLines="_showLines"
								ShowRoot="_showRoot"
								Sort="OnSort"
								CheckedKeys="_checkedKeys"
								CheckedKeysChanged="OnCheckedKeysChanged" />
			</div>
		</div>
		<div class="col-md-5">
			<div class="demo-checked-box">
				<h6>Checked (@_checkedKeys.Count)</h6>
				@if (_checkedKeys.Count == 0)
				{
					<span class="text-muted small">Nothing checked yet.</span>
				}
				else
				{
					<ul class="small mb-0">
						@foreach (var key in _checkedKeys.OrderBy(x => x))
						{
							<li><code>@key</code></li>
						}
					</ul>
				}
			</div>
		</div>
	</div>

	<hr />

	<h4>Folder picker <small class="text-muted">(access-control style)</small></h4>
	<p class="text-muted">
		Folders only, where checking a folder implies its whole subtree: descendants of a checked folder show as
		checked-and-disabled via <code>IsCheckImplied</code> - included through their parent, without being
		redundant picks in <code>CheckedKeys</code>. This is the multiple-folder selection pattern used by
		access-control wizards.
	</p>

	<div class="row">
		<div class="col-md-7">
			<div class="demo-tree-box">
				<PDCheckboxTree TItem="FileExplorerItem"
								DataProvider="_folderProvider"
								KeyField="x => x.Path"
								ParentKeyField="x => x.ParentPath"
								TextField="x => x.Name"
								IconCssClass="GetFolderIconCssClass"
								IsCheckImplied="IsUnderCheckedFolder"
								LoadOnDemand="true"
								ShowRoot="true"
								Sort="OnSort"
								@bind-CheckedKeys="_checkedFolders" />
			</div>
		</div>
		<div class="col-md-5">
			<div class="demo-checked-box">
				<h6>Selected folders (@_checkedFolders.Count)</h6>
				@if (_checkedFolders.Count == 0)
				{
					<span class="text-muted small">No folders selected.</span>
				}
				else
				{
					<ul class="small mb-0">
						@foreach (var key in _checkedFolders.OrderBy(x => x))
						{
							<li><code>@key</code> <span class="text-muted">(includes contents)</span></li>
						}
					</ul>
				}
			</div>
		</div>
	</div>

	<EventView />

</DemoSourceView>
