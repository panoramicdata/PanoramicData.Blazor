    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "PanoramicData.Blazor.Demo",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build PanoramicData.Blazor.Web",
            "program": "${workspaceFolder}/PanoramicData.Blazor.Web/bin/Debug/net10.0/PanoramicData.Blazor.Web.dll",
            "cwd": "${workspaceFolder}/PanoramicData.Blazor.Web",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "PanoramicData.Blazor.WebAssembly",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build PanoramicData.Blazor.WebAssembly.Server",
            "program": "${workspaceFolder}/PanoramicData.Blazor.WebAssembly/Server/bin/Debug/net10.0/PanoramicData.Blazor.WebAssembly.Server.dll",
            "cwd": "${workspaceFolder}/PanoramicData.Blazor.WebAssembly/Server",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "PanoramicData.Blazor.Web",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build PanoramicData.Blazor.Web",
            "program": "${workspaceFolder}/PanoramicData.Blazor.Web/bin/Debug/net10.0/PanoramicData.Blazor.Web.dll",
            "cwd": "${workspaceFolder}/PanoramicData.Blazor.Web",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ]
}